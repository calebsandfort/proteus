#!/usr/bin/env bash
# Kill any dev server processes that might be lingering from worktree panes

# Function to safely kill processes matching a pattern
kill_matching() {
    local pattern="$1"
    local pids
    pids=$(pgrep -f "$pattern" 2>/dev/null) || true
    if [ -n "$pids" ]; then
        echo "Killing processes matching '$pattern': $pids"
        echo "$pids" | xargs -r kill -9 2>/dev/null || true
    fi
}

# Kill dev servers - these patterns match the start-frontend, start-backend, start-api scripts
kill_matching "pnpm dev"
kill_matching "uvicorn.*src.main:app"
kill_matching "dotnet run"
kill_matching "next-server"

echo "Process cleanup done"