.PHONY: test test-verbose test-cov dev build lint

# Run tests with vitest
test:
	pnpm test

# Run tests with verbose output
test-verbose:
	pnpm test --reporter=verbose

# Run tests in watch mode
test-watch:
	pnpm test:watch

# Run tests with coverage
test-cov:
	pnpm test --coverage

# Run development server
dev:
	pnpm dev

# Build for production
build:
	pnpm build

# Run linter
lint:
	pnpm lint
